# ============================================================
# GAPTO MOBILE 2027
# Fichero: .gitignore
# Ruta: .gitignore
# Descripción: Exclusiones del control de versiones.
# Versión: 0.5.0
#   0.5.0: MANT H-B, rutas de máquina fuera del repositorio versionado (CLAUDE.local.md, Claude outputs/).
# ============================================================

# Secretos
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / React Native / Expo
node_modules/
.expo/
dist/
build/
coverage/

# IDE
.vscode/
.idea/

# Sistema
Thumbs.db
.DS_Store

# Logs
*.log
logs/

# Datos reales de migración V3 (RV3-E001 §2)
# Todo data/migration_v3/ queda excluido salvo los placeholders .gitkeep.
# Los datos V3 reales deben vivir FUERA del repositorio (GAPTO_RV3_DATA_DIR):
# la subida web de GitHub NO respeta .gitignore.
data/migration_v3/**
!data/migration_v3/
!data/migration_v3/*/
!data/migration_v3/**/.gitkeep

# Artefactos V3 / RUN reconocibles en cualquier ruta
**/Base_Datos_Personal_py*
**/GaptoMobile_2027_DB*
**/*RUN0[0-9]*.xls*
*.xlsx
*.xlsm
*.xls
*.ods
*.jsonl
*.parquet

# Evidencia RV3 local (debe escribirse fuera del repositorio)
.rv3/
rv3_evidencia/

# Bases, dumps y exports
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.backup

# Temporales
*.tmp
*.temp
~$*

# F05-00-B: journal transitorio del arnes de mutantes VS-01 (D-192) y
# configuracion local del cliente (EXPO_PUBLIC_*: URL y token de desarrollo).
.mutantes_vs01.journal.json
mobile/.env*

# MANT H-B: instrucciones y salidas locales de Claude Code (rutas de esta maquina).
# CLAUDE.local.md lo carga Claude Code junto a CLAUDE.md; nunca se versiona.
CLAUDE.local.md
Claude outputs/
