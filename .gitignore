# ============================================================
# GAPTO MOBILE 2027
# Fichero: .gitignore
# Ruta: .gitignore
# Descripción: Exclusiones del control de versiones.
# Versión: 0.3.0
# ============================================================

# Secretos
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / React Native / Expo
node_modules/
.expo/
dist/
build/
coverage/

# IDE
.vscode/
.idea/

# Sistema
Thumbs.db
.DS_Store

# Logs
*.log
logs/

# Datos reales de migración V3 (RV3-E001 §2)
# Todo data/migration_v3/ queda excluido salvo los placeholders .gitkeep.
# Los datos V3 reales deben vivir FUERA del repositorio (GAPTO_RV3_DATA_DIR):
# la subida web de GitHub NO respeta .gitignore.
data/migration_v3/**
!data/migration_v3/
!data/migration_v3/*/
!data/migration_v3/**/.gitkeep

# Artefactos V3 / RUN reconocibles en cualquier ruta
**/Base_Datos_Personal_py*
**/GaptoMobile_2027_DB*
**/*RUN0[0-9]*.xls*
*.xlsx
*.xlsm
*.xls
*.ods
*.jsonl
*.parquet

# Evidencia RV3 local (debe escribirse fuera del repositorio)
.rv3/
rv3_evidencia/

# Bases, dumps y exports
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.backup

# Temporales
*.tmp
*.temp
~$*
